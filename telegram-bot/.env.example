# ── Telegram ──────────────────────────────────────────────
# Get from @BotFather
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Your personal/owner chat ID (send /start to your bot, then check getUpdates)
OWNER_CHAT_ID=your-chat-id-here

# ── Supabase ──────────────────────────────────────────────
# Same credentials as your website .env.local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Schedule ──────────────────────────────────────────────
# Cron expression for daily report (default: 9 PM daily Cambodia time)
DAILY_REPORT_CRON=0 21 * * *

# Timezone for cron scheduler
TZ=Asia/Phnom_Penh
